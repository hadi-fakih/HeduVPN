[Unit]
Description=HeduVPN relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust to the user that owns /var/lib/heduvpn.
User=heduvpn
Group=heduvpn
WorkingDirectory=/var/lib/heduvpn
ExecStart=/usr/local/bin/heduvpn relay --config /var/lib/heduvpn/relay.json
Restart=on-failure
RestartSec=3
# Binding port 443 without running as root:
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/heduvpn
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
